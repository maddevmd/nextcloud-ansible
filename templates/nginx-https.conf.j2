{% if onlyoffice_domain is defined %}
map $http_upgrade $office_connection_upgrade {
    default upgrade;
    '' close;
}
{% endif %}

server {
    listen 80;
    server_name {{ nextcloud_public_host }};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://{{ nextcloud_public_host }}$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name {{ nextcloud_public_host }};

    ssl_certificate /etc/letsencrypt/live/{{ nextcloud_public_host }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ nextcloud_public_host }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 512M;

    resolver 127.0.0.11 valid=30s ipv6=off;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        set $nextcloud_backend nextcloud:80;

        proxy_pass http://$nextcloud_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

