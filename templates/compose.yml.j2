name: nextcloud-lab

services:
  nginx:
    image: nginx:stable-alpine
    restart: unless-stopped
    ports:
      - "{{ ansible_host }}:{{ nginx_http_port }}:80"
{% if nginx_tls | default(false) %}
      - "{{ ansible_host }}:{{ nginx_https_port }}:443"
{% endif %}
    volumes:
      - ./nginx:/etc/nginx/conf.d:ro
{% if nginx_tls | default(false) %}
      - ./letsencrypt:/etc/letsencrypt:ro
      - ./acme-webroot:/var/www/acme:ro
{% endif %}

  minio:
    image: nextcloud-lab/minio:2025-10-15
    pull_policy: never
    restart: unless-stopped
    command: ["server", "/data", "--console-address", ":9001"]
    environment:
      MINIO_ROOT_USER: nextcloud-storage-admin
      MINIO_ROOT_PASSWORD_FILE: /run/secrets/minio_root_password
    secrets:
      - minio_root_password
    volumes:
      - ./data/minio:/data
    networks:
      - storage

  postgres:
    image: postgres:17-bookworm
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_DB: nextcloud
      POSTGRES_PASSWORD_FILE: /run/secrets/postgres_admin_password
    secrets:
      - postgres_admin_password
      - nextcloud_db_password
{% if authentik_domain is defined %}
      - authentik_db_password
{% endif %}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - database
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d nextcloud"]
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 10s

  redis:
    image: redis:7.4.11-alpine
    restart: unless-stopped
    command:
      - redis-server
      - --save
      - ""
      - --appendonly
      - "no"
      - --maxmemory
      - 256mb
      - --maxmemory-policy
      - noeviction
    networks:
      - cache
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 5s

  nextcloud:
    image: "{{ nextcloud_image }}"
    profiles:
      - application
    restart: unless-stopped
    environment: &nextcloud_environment
      NEXTCLOUD_ADMIN_USER: "{{ nextcloud_admin_user }}"
      NEXTCLOUD_ADMIN_PASSWORD_FILE: /run/secrets/nextcloud_admin_password
      NEXTCLOUD_TRUSTED_DOMAINS: "{{ nextcloud_public_host }}"

      POSTGRES_HOST: postgres
      POSTGRES_DB: nextcloud
      POSTGRES_USER: nextcloud
      POSTGRES_PASSWORD_FILE: /run/secrets/nextcloud_db_password

      REDIS_HOST: redis
      REDIS_HOST_PORT: "6379"

      OBJECTSTORE_S3_HOST: minio
      OBJECTSTORE_S3_PORT: "9000"
      OBJECTSTORE_S3_BUCKET: nextcloud
      OBJECTSTORE_S3_REGION: us-east-1
      OBJECTSTORE_S3_KEY: nextcloud
      OBJECTSTORE_S3_SECRET_FILE: /run/secrets/nextcloud_s3_secret_key
      OBJECTSTORE_S3_SSL: "false"
      OBJECTSTORE_S3_USEPATH_STYLE: "true"
      OBJECTSTORE_S3_AUTOCREATE: "false"

      OVERWRITEHOST: "{{ nextcloud_public_host }}"
      OVERWRITEPROTOCOL: "{{ nextcloud_public_protocol }}"
      OVERWRITECLIURL: "{{ nextcloud_public_protocol }}://{{ nextcloud_public_host }}"
      PHP_MEMORY_LIMIT: 256M

    secrets:
      - nextcloud_admin_password
      - nextcloud_db_password
      - nextcloud_s3_secret_key
{% if onlyoffice_image is defined %}
      - onlyoffice_jwt_secret
{% endif %}
{% if nextcloud_oidc_client_id is defined %}
      - nextcloud_oidc_client_secret
{% endif %}

    volumes:
      - nextcloud_html:/var/www/html

    networks:
      - default
      - storage
      - database
      - cache

  nextcloud-cron:
    image: "{{ nextcloud_image }}"
    profiles:
      - application
    restart: unless-stopped
    entrypoint: /cron.sh
    environment: *nextcloud_environment
    secrets:
      - nextcloud_admin_password
      - nextcloud_db_password
      - nextcloud_s3_secret_key
    volumes:
      - nextcloud_html:/var/www/html
    networks:
      - default
      - storage
      - database
      - cache

{% if onlyoffice_image is defined %}
  onlyoffice:
    image: "{{ onlyoffice_image }}"
    profiles:
      - office
    restart: unless-stopped
    entrypoint:
      - /bin/sh
      - /usr/local/bin/onlyoffice-start.sh
    environment:
      JWT_ENABLED: "true"
      JWT_HEADER: AuthorizationJwt
      JWT_IN_BODY: "true"
    secrets:
      - onlyoffice_jwt_secret
    volumes:
      - ./onlyoffice/start.sh:/usr/local/bin/onlyoffice-start.sh:ro
      - onlyoffice_data:/var/www/onlyoffice/Data
      - onlyoffice_postgres:/var/lib/postgresql
      - onlyoffice_logs:/var/log/onlyoffice
    networks:
      - default
{% endif %}

{% if authentik_image is defined %}
  authentik-server:
    image: "{{ authentik_image }}"
    profiles:
      - identity
    restart: unless-stopped
    user: "1000:1000"
    command: server
    shm_size: 512mb
    environment: &authentik_environment
      AUTHENTIK_POSTGRESQL__HOST: postgres
      AUTHENTIK_POSTGRESQL__PORT: "5432"
      AUTHENTIK_POSTGRESQL__NAME: authentik
      AUTHENTIK_POSTGRESQL__USER: authentik
      AUTHENTIK_POSTGRESQL__SSLMODE: disable
      AUTHENTIK_POSTGRESQL__PASSWORD: file:///run/secrets/authentik_db_password
      AUTHENTIK_SECRET_KEY: file:///run/secrets/authentik_secret_key
    secrets:
      - authentik_db_password
      - authentik_secret_key
    volumes:
      - ./data/authentik:/data
    networks:
      - default
      - database
    depends_on:
      postgres:
        condition: service_healthy

  authentik-worker:
    image: "{{ authentik_image }}"
    profiles:
      - identity
    restart: unless-stopped
    user: root
    command: worker
    shm_size: 512mb
    environment: *authentik_environment
    secrets:
      - authentik_db_password
      - authentik_secret_key
    volumes:
      - ./data/authentik:/data
    networks:
      - default
      - database
    depends_on:
      postgres:
        condition: service_healthy
{% endif %}

secrets:
  minio_root_password:
    file: ./secrets/minio_root_password
  postgres_admin_password:
    file: ./secrets/postgres_admin_password
  nextcloud_db_password:
    file: ./secrets/nextcloud_db_password
  nextcloud_admin_password:
    file: ./secrets/nextcloud_admin_password
  nextcloud_s3_secret_key:
    file: ./secrets/nextcloud_s3_secret_key
{% if onlyoffice_image is defined %}
  onlyoffice_jwt_secret:
    file: ./secrets/onlyoffice_jwt_secret
{% endif %}
{% if authentik_domain is defined %}
  authentik_db_password:
    file: ./secrets/authentik_db_password
  authentik_secret_key:
    file: ./secrets/authentik_secret_key
{% endif %}
{% if nextcloud_oidc_client_id is defined %}
  nextcloud_oidc_client_secret:
    file: ./secrets/nextcloud_oidc_client_secret
{% endif %}

networks:
  storage:
    internal: true
  database:
    internal: true
  cache:
    internal: true

volumes:
  postgres_data:
  nextcloud_html:
{% if onlyoffice_image is defined %}
  onlyoffice_data:
  onlyoffice_postgres:
  onlyoffice_logs:
{% endif %}
